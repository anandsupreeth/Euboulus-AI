frontend/blob-report/
frontend/playwright/.auth/
playwright/.auth/
storageState*.json
.auth/

# Logs and coverage (can leak tokens and personal data)
*.log
logs/
coverage/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS / tool-local settings
.vscode/
.idea/
.DS_Store
Thumbs.db
