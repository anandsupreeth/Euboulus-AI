# Recorded interview audio (user data)
backend/storage/

# ---------------------------------------------------------------------------
# Additional private / generated files (added in a security review)
# ---------------------------------------------------------------------------

# More environment variants (dotenv, direnv, framework-specific)
.envrc
*.env
!*.env.example
!.env.example
.env.local
.env.*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# Keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.csr
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
