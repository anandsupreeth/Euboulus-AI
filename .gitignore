client_secret*.json
service-account*.json
*-service-account.json
*serviceaccount*.json
gcp-key*.json
secrets.json
secrets.yaml
secrets.yml
secrets.toml
*.secret
*.secrets
secrets/
.secrets/
.aws/
.ssh/
.npmrc
.pypirc
.netrc
.htpasswd

# Local databases and dumps (may hold user data and password hashes)
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.bak
mongodb-data/
data/db/

# Browser-test artefacts (can contain saved sessions, cookies and tokens)
frontend/test-results/
