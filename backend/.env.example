# Local MongoDB server, or replace with a MongoDB Atlas connection string.
# Never commit real credentials or production connection strings.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ai_interview_prep
MONGODB_COLLECTION_INTERVIEWS=interviews

# OpenAI (voice interviews). Put your real key only in backend/.env.
OPENAI_API_KEY=
# OPENAI_VOICE_MODEL=gpt-audio-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TEXT_MODEL=gpt-4o-mini
